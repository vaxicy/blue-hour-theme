  "semanticTokenColors": {
    "function": "#9CB6D8",
    "method": "#9CB6D8",
    "class": "#C5B3D0",
    "type": "#C5B3D0",
    "string": "#A8C5BD",
    "number": "#D8C29E",
    "keyword": "#B0B8E0",
    "comment": "#8391AD"
  },
  "tokenColors": [
    {
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#8391AD"
      }
    },
    {
      "scope": [
        "keyword",
        "storage"
      ],
      "settings": {
        "foreground": "#B0B8E0"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#A8C5BD"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#D8C29E"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#C5B3D0"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#9CB6D8"
      }
    },
    {
      "scope": [
        "variable"
      ],
      "settings": {
        "foreground": "#EAE0CF"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#B0B8E0"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#EAC18C"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#B0B8E0"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#E69DA8"
      }
    }
