  "semanticHighlighting": true,
  "semanticTokenColors": {
    "function": "#46658B",
    "method": "#46658B",
    "class": "#756082",
    "type": "#756082",
    "string": "#46716D",
    "number": "#886A3F",
    "keyword": "#4B5694",
    "comment": "#7D807F"
  },
  "tokenColors": [
    {
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#7D807F"
      }
    },
    {
      "scope": [
        "keyword",
        "storage"
      ],
      "settings": {
        "foreground": "#4B5694"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#46716D"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#886A3F"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#756082"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#46658B"
      }
    },
    {
      "scope": [
        "variable"
      ],
      "settings": {
        "foreground": "#303952"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#4B5694"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#886A3F"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#4B5694"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#AB4858"
      }
    }
  ]
